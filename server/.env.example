# PostgreSQL
DATABASE_URL=postgres://sopy:sopy@localhost:5432/sopy

# Auth
JWT_SECRET=change-this-to-a-long-random-string

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Where photos and shared report PDFs are kept. Must be outside the app
# folder in production: Hostinger replaces that folder at every deploy.
# Empty = ~/sopy-data in production, server/uploads and server/storage locally.
DATA_DIR=

# Paddle Billing (https://vendors.paddle.com)
# API key: Developer Tools > Authentication (server-side, keep secret)
PADDLE_API_KEY=
# Webhook signing secret: Developer Tools > Notifications > your endpoint
PADDLE_WEBHOOK_SECRET=
# Client-side token used by @paddle/paddle-js in the browser (safe to expose)
PADDLE_CLIENT_TOKEN=
# 'sandbox' while testing, 'production' when live
PADDLE_ENV=sandbox

# Paymob (Egypt). Checkout on a device in Egypt (or, when the phone won't
# share its location, for a business registered in Egypt) pays in EGP
# through Paymob. Leave empty to give everyone the card checkout.
# Keys: Paymob dashboard > Settings > Account info (secret key, public key, HMAC)
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Developers > Payment integrations: the integration IDs to offer (card, wallet...), comma separated
PAYMOB_INTEGRATION_IDS=
# Exchange rate used to turn the USD price into EGP, e.g. 50
PAYMOB_EGP_PER_USD=
# Public address of this app, used for Paymob's callback and return links
# (e.g. https://app.sopy.example). Defaults to the address the browser uses.
APP_URL=

# Web Push (phone notifications). Generate a key pair once with
#   npx web-push generate-vapid-keys
# and keep it: changing it cuts off every phone that already subscribed.
# Leave empty to turn phone notifications off (the in-app ones still work).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who push services can contact about this sender (mailto: or https:)
VAPID_SUBJECT=mailto:support@example.com

# Forgot password: a 6-digit code by email or text message. A way that's
# left empty isn't offered (people can still get a reset link from their
# manager). Without these, a local (non-production) server prints the codes
# in its console instead.
# Email, through any SMTP server (Gmail/Google Workspace, Zoho, SendGrid,
# Brevo, Mailgun...). Port 465 uses TLS from the start; 587 uses STARTTLS.
# On Hostinger: make a mailbox (hPanel > Emails), e.g. no-reply@yourdomain.com,
# then SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465, SMTP_USER=that address,
# SMTP_PASS=its password, SMTP_FROM=SOPY <that address>. The server log says
# at start-up whether it could log in.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Who the email comes from, e.g. SOPY <no-reply@yourdomain.com>
SMTP_FROM=
# Text messages, through Twilio (console.twilio.com): the account SID and
# auth token, and either a sending number / sender name or a Messaging
# Service SID (MG...).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
