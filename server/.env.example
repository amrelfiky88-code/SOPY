# PostgreSQL
DATABASE_URL=postgres://sopy:sopy@localhost:5432/sopy

# Auth
JWT_SECRET=change-this-to-a-long-random-string

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Paddle Billing (https://vendors.paddle.com)
# API key: Developer Tools > Authentication (server-side, keep secret)
PADDLE_API_KEY=
# Webhook signing secret: Developer Tools > Notifications > your endpoint
PADDLE_WEBHOOK_SECRET=
# Client-side token used by @paddle/paddle-js in the browser (safe to expose)
PADDLE_CLIENT_TOKEN=
# 'sandbox' while testing, 'production' when live
PADDLE_ENV=sandbox
